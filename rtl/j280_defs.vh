// ============================================================================
// j280_defs.vh — 全局数值约定与参数（单一事实来源）
// ============================================================================
// 【数值约定】所有控制通路信号统一用以下定点格式，改约定必须改这里并全工程联查：
//
//   alpha        : s16, 单位 0.01°，零点 = 倒立点（摆杆向上为 0）
//   alpha_dot    : s16, 单位 0.1 °/s
//   theta_e      : s16, 单位 0.01°，= theta - theta_ref（未回绕展开量）
//   theta_dot    : s16, 单位 0.1 °/s
//   duty         : s16, 单位 0.01%，满幅 ±10000 = ±100%
//   增益 K1..K4   : s16, Q3.13（范围 [-4, +4)，LSB = 2^-13 = 1.22e-4，单位 duty/状态单位）
//   编码器位置    : s32 原始计数，1 圈 = CNT_PER_REV 个计数（默认 1040 = 260*4倍频）
//   ADC 平均输出  : u16，满量程 2V ↔ 65472（1023×64，345°电气行程）
//
// 【极性约定】（到手第 1 天必须实测确认，见架构文档 §6，错了会飞车）：
//   alpha 增大方向 = 摆杆向"电机正转使臂加速"的反方向倾倒 → u = +K·x 为负反馈。
//   若实测相反：改 POL_ALPHA_FLIP / POL_ENC_FLIP 两个开关即可，不许改增益符号。
// ============================================================================
`timescale 1ns / 1ps
`ifndef J280_DEFS_VH
`define J280_DEFS_VH

// ---- 时钟与节拍 ----
// 每板构建时设定 J280_CLK_HZ：共享 RTL 默认 50MHz（DE10），T20K 构建快照由
// gowin_t20k/run_t20k.ps1 文本替换为 27MHz 晶振直驱（2026-10-27 降档：
// 时序余量 ±1.5%→约 85%，PnR 从掷骰变确定；控制环全在 1kHz tick 域，
// 行为零变化——详见 docs/2026-10-27_27MHz主频降档实现方案.md）。
`ifndef J280_CLK_HZ
`define J280_CLK_HZ   50_000_000
`endif
`define CLK_HZ        `J280_CLK_HZ
`define TICK_MS_MAX   (`CLK_HZ/1000)  // 1ms 控制节拍
// 载波：27MHz 用 1250 级（21.6kHz，duty/8 纯移位且满幅精确）；
// 50MHz 保持 2500 级（20kHz，duty/4）——两者都是 CARRIER=duty_full/8 或 /4。
`define PWM_CARRIER   ((`CLK_HZ == 27_000_000) ? 1_250 : 2_500)
`define ADC_CLK_DIV   2               // ADC 时钟 = 50M/2 = 25MHz（官方时序）
`define ADC_AVG_N     9               // 滑动平均 2^9 = 512 次（约 20.5µs 窗口）
`define UART_BAUD_DIV (`CLK_HZ/1_000_000)   // 1Mbaud（CH340 上限 2M）
`define TEL_PERIOD_MS 2               // 遥测帧间隔 = 2ms（500Hz）

// ---- 机械常量（到手实测后修正，见架构文档 §6-2）----
`define CNT_PER_REV   1040            // 摆臂一圈编码器计数（官方口径 260*4，需实测确认）
`define DEG_PER_CNT_X100  3462        // 36000*100/1040 ≈ 3462（0.01°/计数 的 100 倍定点，见 arm_vel）

// ---- 传感器极性开关（默认不翻转，到手实测后修正）----
`define POL_ALPHA_FLIP 0              // 1: alpha 取反
`define POL_ENC_FLIP   0              // 1: 编码器计数方向取反

// ---- 起摆重试策略 ----
// 0: 单次起摆，掉摆后进入 SAFE，重新启动才允许下一次尝试
// 1: BALANCE/POS 掉摆后自动重新进入 SWING（旧行为）
`define AUTO_RESWING   0

// ---- 模式状态机编码 ----
`define M_IDLE    3'd0
`define M_SWING   3'd1
`define M_BALANCE 3'd2
`define M_POS     3'd3
`define M_SAFE    3'd4

// ---- 捕获域/掉摆阈值（0.01° 与 0.1°/s 单位；可被 param_regs 在线覆盖）----
// Capture also requires |theta_dot| < 500deg/s (mode_fsm).
`define CATCH_ANG      16'sd3000       // |alpha| < 30.00° 进入稳摆
`define CATCH_ANG_H    16'sd6000       // |alpha| > 60.00° 判掉摆（滞回）
`define CAL_AVG_TICKS  2000            // 标定采样 2s（1ms × 2000）

// Swing coefficients and cosine LUT are generated by lqr_to_rtl.m.

`endif // J280_DEFS_VH
